# ==============================================================================
# AffinityAI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `server/.env` (and/or `.env` in the root):
#    Windows PowerShell: Copy-Item .env.example server/.env
#    Linux/macOS Bash:   cp .env.example server/.env
# 2. Update the placeholder values below with your environment configuration.
# 3. Never commit real credentials, production secrets, or .env files to Git.
# ==============================================================================

# Port on which the Express backend will listen
PORT=5000

# Node environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# JWT Secret Key: In production, must be at least 32 characters long and cryptographically random.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_key

# Allowed CORS client origins (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Python interpreter executable command or absolute path
# Windows: py (or python)
# Linux/macOS: python3 (or /usr/bin/python3)
PYTHON_PATH=py
