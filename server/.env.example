# ==============================================================================
# AffinityAI Server Environment Configuration
# ==============================================================================
# Instructions:
# Copy this file to `.env` inside the `server/` directory:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS Bash:   cp .env.example .env
# ==============================================================================

PORT=5000
NODE_ENV=development

# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_key

# Allowed CORS client origins
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Python interpreter command: 'py' (Windows) or 'python3' (Linux/macOS)
PYTHON_PATH=py
